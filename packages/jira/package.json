{
  "name": "@frehilm/ordna-jira",
  "version": "0.1.0",
  "description": "Jira backend for Ordna. Reads Jira issues through the TaskProvider plugin contract so the Ordna CLI / TUI / Web UI can drive a Jira board the same way it drives markdown files.",
  "license": "MIT",
  "author": "FreHilm <1584617+FreHilm@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreHilm/ordna.git",
    "directory": "packages/jira"
  },
  "homepage": "https://github.com/FreHilm/ordna/tree/main/packages/jira#readme",
  "bugs": "https://github.com/FreHilm/ordna/issues",
  "keywords": ["jira", "ordna", "kanban", "plugin", "task-provider"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@frehilm/ordna-core": "^0.2.0 || workspace:^"
  },
  "devDependencies": {
    "@frehilm/ordna-core": "workspace:^",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
