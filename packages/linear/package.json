{
  "name": "@frehilm/ordna-linear",
  "version": "0.1.0",
  "description": "Linear backend for Ordna. Reads Linear issues through the TaskProvider plugin contract so the Ordna CLI / TUI / Web UI can drive a Linear board the same way it drives markdown files.",
  "license": "MIT",
  "author": "FreHilm <1584617+FreHilm@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreHilm/ordna.git",
    "directory": "packages/linear"
  },
  "homepage": "https://github.com/FreHilm/ordna/tree/main/packages/linear#readme",
  "bugs": "https://github.com/FreHilm/ordna/issues",
  "keywords": ["linear", "ordna", "kanban", "plugin", "task-provider"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@frehilm/ordna-core": "^0.2.0 || workspace:^"
  },
  "dependencies": {
    "graphql-ws": "^5.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@frehilm/ordna-core": "workspace:^",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
